# ------------------------------------------------------------
# API / Backend
# ------------------------------------------------------------
# Full URL to the PHP backend (must end with a trailing slash)
# Development : http://localhost/WEBSITE-backend/
# Production  : https://website-backend-gp6q.onrender.com/
VITE_API_BASE_URL=https://website-backend-gp6q.onrender.com/

# ------------------------------------------------------------
# Socket / WebSocket Server
# ------------------------------------------------------------
# URL to the Node.js socket server
# Development : http://localhost:3001
# Production  : https://europe-conference.onrender.com
VITE_SOCKET_URL=https://europe-conference.onrender.com
