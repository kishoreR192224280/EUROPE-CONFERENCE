# ============================================================
# EUROPE CONFERENCE QUIZ — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to version control.
# ============================================================

# ------------------------------------------------------------
# API / Backend
# ------------------------------------------------------------
# Full URL to the PHP backend (must end with a trailing slash)
# Development : http://localhost/WEBSITE-backend/
# Production  : https://yourdomain.com/api/
VITE_API_BASE_URL=http://localhost/WEBSITE-backend/

# ------------------------------------------------------------
# Socket / WebSocket Server
# ------------------------------------------------------------
# URL to the Node.js socket server
# Development : http://localhost:3001
# Production  : https://yourdomain.com (if running on same host with a proxy)
#             or https://socket.yourdomain.com
VITE_SOCKET_URL=http://localhost:3001
